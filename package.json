{
  "name": "petlove-figma-react-native",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/dev.mjs --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "mobile": "node scripts/dev.mjs",
    "frontend": "expo start",
    "backend": "npm start --prefix backend",
    "postinstall": "npm install --prefix backend",
    "typecheck": "tsc --noEmit",
    "test": "npm test --prefix backend && node --test tests/api.integration.mjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
